// mapper .rc file
// Example resource.rc file
1 VERSIONINFO
FILEVERSION     1,2,10,0
PRODUCTVERSION  1,2,10,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4" // US English
        BEGIN
            VALUE "ACK Software", "Your Name or LocalDev"
            VALUE "Mapper application", "My Local C++ Application"
            VALUE "FileVersion", "1.2.10.0"
            VALUE "Mapper", "my_app"
            VALUE "LegalCopyright", "Copyright (c) 2026"
            VALUE "mapper.exe", "my_app.exe"
            VALUE "Mapper", "My App"
            VALUE "ProductVersion", "1.2.10.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END